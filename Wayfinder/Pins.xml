<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- World map icon; the mixin lives in MapPins.lua, loaded just before this file. -->
	<Frame name="WayfinderMapPinTemplate" mixin="WayfinderMapPinMixin" enableMouse="true" virtual="true">
		<Size x="18" y="18"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="Highlight" setAllPoints="true" alphaMode="ADD" alpha="0.45"/>
			</Layer>
		</Layers>
	</Frame>
</Ui>
